---
import Section from "../Section.astro";
import { projects } from "@cv"
---

<Section title="Proyectos">
    <ul class="projects-grid">
        {
            projects.map(({ url, description, highlights, name, isActive }) => {
                return (
                    <li>
                        <article>
                            <header>
                                <h3>
                                    <a href={url} target="_blank" rel="noopener noreferrer" title={`Ver el proyecto ${name}`}>
                                        {name}
                                    </a>
                                    <span class={isActive ? "status-dot active" : "status-dot inactive"}>●</span>
                                </h3>
                                <p class="description">{description}</p>
                            </header>
                            
                            {highlights && highlights.length > 0 && (
                                <ul class="highlights-list">
                                    {highlights.map((highlight) => {
                                        return <li>{highlight}</li>
                                    })}
                                </ul>
                            )}
                        </article>
                    </li>
                )
            })
        }
    </ul>
</Section>

<style>
    .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 1.5rem;
        padding: 0;
        margin: 0;
        list-style: none;
        align-items: start;
    }

    article {
        border-radius: 12px;
        border: 1px solid var(--color-card-border);
        background: rgba(255, 255, 255, 0.01);
        display: flex;
        flex-direction: column;
        padding: 24px;
        transition: all 0.3s ease;
    }

    article:hover {
        border-color: var(--color-accent);
        background: rgba(255, 255, 255, 0.03);
    }

    article h3 {
        margin: 0 0 10px 0;
        font-size: 1.25rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    article a {
        color: var(--color-text);
        text-decoration: none;
        font-weight: 700;
    }

    article a:hover {
        text-decoration: underline;
    }

    .status-dot {
        font-size: 0.8rem;
        line-height: 0;
        margin-top: -2px;
    }

    .status-dot.active {
        color: #22c55e;
    }

    .status-dot.inactive {
        color: #ef4444;
    }

    .description {
        font-size: 0.82rem;
        line-height: 1.5;
        color: #707070;
        margin: 0 0 16px 0;
        text-align: justify;
        text-justify: inter-word;
    }

    .highlights-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding-left: 0;
        margin: 0;
        list-style: none;
    }

    .highlights-list li {
        font-size: 0.78rem;
        line-height: 1.4;
        color: #999999;
        position: relative;
        padding-left: 16px;
        text-align: justify;
    }

    .highlights-list li::before {
        content: "◦";
        position: absolute;
        left: 2px;
        top: 0px;
        color: var(--color-accent);
        font-weight: bold;
        font-size: 0.85rem;
    }
</style>